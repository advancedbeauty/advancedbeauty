generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Service {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  slug               String               @unique
  category           String
  images             String[]
  description        String?
  details            Json?
  price              Float
  listPrice          Float
  tags               String[]             @default(["new arrival"])
  avgRating          Float                @default(0)
  numReviews         Int                  @default(0)
  ratingDistribution RatingDistribution[]
  numSales           Int                  @default(0)
  isPublished        Boolean              @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]

  @@map("services")
}

type RatingDistribution {
  rating Int
  count  Int
}

model Review {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  rating             Int
  comment            String
  productId          String  @db.ObjectId
  isVerifiedPurchase Boolean @default(false)
  userId             String  @db.ObjectId

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model Order {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  items         Json[]
  name          String
  phone         String
  email         String
  address       String
  address2      String?
  city          String
  country       String
  postalCode    String
  offerCode     String?
  offerDiscount Float?
  paymentMethod String?
  totalPrice    Float
  isPaid        Boolean   @default(false)
  startDate     DateTime  @default(now())
  endDate       DateTime?
  isCompleted   Boolean   @default(false)
  isCancelled   Boolean   @default(false)
  isRefunded    Boolean   @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  name          String
  role          String    @default("U")
  password      String?
  image         String?
  emailVerified DateTime?
  wishlistIds   String[]  @default([])
  reviews       Review[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Account Account[]
  Session Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model HeroBanner {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  image       String
  mdImage     String
  link        String
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_banners")
}

model Offer {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  image              String
  offerCode          String
  discountPercentage Float
  maxAmount          Int
  isPublished        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offers")
}
