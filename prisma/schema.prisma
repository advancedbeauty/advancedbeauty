generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Service {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  slug               String               @unique
  category           String
  images             String[]
  description        String?
  details            Json?
  price              Float
  listPrice          Float
  tags               String[]             @default(["new arrival"])
  avgRating          Float                @default(0)
  numReviews         Int                  @default(0)
  ratingDistribution RatingDistribution[]
  numSales           Int                  @default(0)
  isPublished        Boolean              @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews    Review[]
  orderItems OrderItem[]

  @@map("service")
}

type RatingDistribution {
  rating Int
  count  Int
}

model Review {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  rating             Int
  comment            String
  productId          String  @db.ObjectId
  isVerifiedPurchase Boolean @default(false)
  userId             String  @db.ObjectId

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("review")
}

model Order {
  id                   String          @id @default(auto()) @map("_id") @db.ObjectId
  user                 User            @relation(fields: [userId], references: [id])
  userId               String          @db.ObjectId
  items                OrderItem[]
  shippingAddress      ShippingAddress
  expectedDeliveryDate DateTime
  paymentMethod        String
  itemsPrice           Float
  shippingPrice        Float
  taxPrice             Float
  totalPrice           Float
  isPaid               Boolean         @default(false)
  paidAt               DateTime?
  isDelivered          Boolean         @default(false)
  deliveredAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

type OrderItem {
  product      String  @db.ObjectId
  clientId     String
  name         String
  slug         String
  image        String
  category     String
  price        Float
  countInStock Int
  quantity     Int
  size         String?
  color        String?
}

type ShippingAddress {
  fullName   String
  street     String
  city       String
  postalCode String
  country    String
  province   String
  phone      String
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  name          String
  role          String   @default("User")
  password      String?
  image         String?
  emailVerified Boolean  @default(false)
  reviews       Review[]
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
